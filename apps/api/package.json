{
  "name": "@attractory/api",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/src/main.js",
    "start:prod": "node dist/src/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint src prisma/seed.ts test",
    "typecheck": "tsc --noEmit",
    "prisma": "prisma",
