    "@attractory/validators": "workspace:*",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "^12.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "6.19.3",
    "bullmq": "^5.61.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@nestjs/cli": "^12.0.11",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.0",
    "prisma": "6.19.3",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
